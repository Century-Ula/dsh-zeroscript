{
  "name": "dsh-zeroscript",
  "version": "1.2.0",
  "private": true,
  "description": "Drive Roblox Studio from the DeepSeek Harness agent: the ZeroScript bridge as a DSH plugin, with 28+ Studio tools, a web console, and no terminal window.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Century-Ula/dsh-zeroscript.git"
  },
  "homepage": "https://github.com/Century-Ula/dsh-zeroscript#readme",
  "bugs": {
    "url": "https://github.com/Century-Ula/dsh-zeroscript/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "roblox",
    "roblox-studio",
    "mcp",
    "zeroscript",
    "ai-agent",
    "luau",
    "blender",
    "3dsmax"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "docs",
    "tools/verify-detect.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/detect.test.mjs && node tests/client.test.mjs && node tests/multiserver.test.mjs && node tests/robloxUpload.test.mjs && node tests/launcher.test.mjs",
    "test:live": "node tests/bridge.test.mjs && node tests/routes.test.mjs",
    "verify:detect": "node tools/verify-detect.mjs"
  }
}
